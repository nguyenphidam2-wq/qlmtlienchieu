    },
    {
      "page": "/businesses",
      "regex": "^/businesses(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/businesses(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/gis",
      "regex": "^/gis(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/gis(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
