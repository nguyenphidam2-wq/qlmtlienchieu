    },
    {
      "page": "/migrate",
      "regex": "^/migrate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/migrate(?:/)?$"
    },
    {
      "page": "/pccc",
      "regex": "^/pccc(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pccc(?:/)?$"
    },
    {
      "page": "/schedules",
      "regex": "^/schedules(?:/)?$",
      "routeKeys": {},
