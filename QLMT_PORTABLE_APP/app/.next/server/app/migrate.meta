{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/migrate/layout,_N_T_/migrate/page,_N_T_/migrate"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/migrate/__PAGE__",
    "/migrate",
    "/_index",
    "/_head"
  ]
}